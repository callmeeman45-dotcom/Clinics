<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Receptionist Panel — Alshifa Clinic</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,600;9..144,700&family=Work+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
<style>
  :root {
    --bg-ivory: #FBF8F5;
    --white: #FFFFFF;
    --red-deep: #6E1423;
    --red-accent: #A31D2E;
    --red-soft: #F4E3E1;
    --charcoal: #201C1B;
    --grey: #6B615E;
    --hairline: rgba(32, 28, 27, 0.14);
    --radius: 3px;
    --green: #2F6B3F;

    --sidebar-w: 272px;
    --sidebar-w-mobile: 84%;
  }

  * { margin: 0; padding: 0; box-sizing: border-box; }

  body {
    font-family: 'Work Sans', sans-serif;
    color: var(--charcoal);
    background: var(--bg-ivory);
    display: grid;
    grid-template-columns: var(--sidebar-w) 1fr;
    min-height: 100vh;
  }

  h1, h2, h3, .brand { font-family: 'Fraunces', serif; font-weight: 600; }

  /* ================= SIDEBAR ================= */
  .sidebar {
    position: relative;
    background:
      linear-gradient(180deg, rgba(255,255,255,0.05) 0%, rgba(0,0,0,0.08) 100%),
      var(--red-deep);
    color: var(--white);
    padding: 30px 22px 22px;
    display: flex;
    flex-direction: column;
    box-shadow: 1px 0 0 rgba(0,0,0,0.06);
  }

  .sidebar::after {
    content: "";
    position: absolute;
    top: 0; right: 0;
    width: 1px;
    height: 100%;
    background: linear-gradient(180deg, rgba(255,255,255,0.22), rgba(255,255,255,0));
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 12px;
    font-size: 1.2rem;
    letter-spacing: 0.01em;
    margin-bottom: 40px;
    padding: 0 4px;
  }

  .brand .mark {
    width: 34px;
    height: 34px;
    border-radius: 50%;
    background: rgba(255,255,255,0.12);
    border: 1px solid rgba(255,255,255,0.28);
    display: flex;
    align-items: center;
    justify-content: center;
    flex: none;
  }

  .brand .mark svg { width: 16px; height: 16px; }

  .brand-text { display: flex; flex-direction: column; line-height: 1.2; }
  .brand-text small {
    font-family: 'Work Sans', sans-serif;
    font-weight: 500;
    font-size: 0.66rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #E7CFCF;
  }

  .sidebar-scroll {
    flex: 1;
    overflow-y: auto;
    margin: 0 -8px;
    padding: 0 8px;
  }

  .nav-label {
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: rgba(231, 207, 207, 0.65);
    padding: 0 14px;
    margin-bottom: 10px;
  }

  .sidebar nav ul { list-style: none; }
  .sidebar nav li { margin-bottom: 3px; }

  .sidebar nav a {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 11px 14px;
    border-radius: 6px;
    color: #E7CFCF;
    text-decoration: none;
    font-size: 0.895rem;
    font-weight: 500;
    position: relative;
    transition: background 0.15s ease, color 0.15s ease;
  }

  .sidebar nav a svg {
    width: 17px;
    height: 17px;
    flex: none;
    opacity: 0.85;
  }

  .sidebar nav a:hover {
    color: var(--white);
    background: rgba(255,255,255,0.08);
  }

  .sidebar nav a.active {
    background: rgba(255,255,255,0.14);
    color: var(--white);
  }

  .sidebar nav a.active svg { opacity: 1; }

  .sidebar nav a.active::before {
    content: "";
    position: absolute;
    left: -22px;
    top: 50%;
    transform: translateY(-50%);
    width: 3px;
    height: 60%;
    background: var(--white);
    border-radius: 0 3px 3px 0;
  }

  .nav-divider {
    height: 1px;
    background: rgba(255,255,255,0.14);
    margin: 18px 6px;
  }

  .sidebar .staff-tag {
    margin-top: 18px;
    padding: 14px;
    border-radius: 8px;
    background: rgba(0,0,0,0.14);
    border: 1px solid rgba(255,255,255,0.12);
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .staff-tag .avatar {
    width: 38px;
    height: 38px;
    border-radius: 50%;
    background: rgba(255,255,255,0.16);
    border: 1px solid rgba(255,255,255,0.3);
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: 'Fraunces', serif;
    font-weight: 600;
    font-size: 0.85rem;
    color: var(--white);
    flex: none;
  }

  .staff-tag .staff-meta { min-width: 0; }

  .staff-tag strong {
    display: block;
    color: var(--white);
    font-size: 0.88rem;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .staff-tag span {
    font-size: 0.76rem;
    color: #E7CFCF;
  }

  .mobile-bar { display: none; }
  .sidebar-backdrop { display: none; }

  /* ---- MAIN ---- */
  main { padding: 44px 52px; }

  .page-head { margin-bottom: 36px; }
  .page-head .eyebrow {
    text-transform: uppercase;
    letter-spacing: 0.12em;
    font-size: 0.72rem;
    font-weight: 600;
    color: var(--red-accent);
    display: block;
    margin-bottom: 8px;
  }
  .page-head h1 { font-size: 1.7rem; }
  .page-head p { color: var(--grey); font-size: 0.92rem; margin-top: 6px; }

  /* ---- SEARCH ---- */
  .search-card {
    background: var(--white);
    border: 1px solid var(--hairline);
    border-radius: var(--radius);
    padding: 28px;
    margin-bottom: 28px;
  }

  .search-row { display: flex; gap: 12px; }

  .search-row input {
    flex: 1;
    padding: 13px 16px;
    border: 1px solid var(--hairline);
    border-radius: var(--radius);
    font-size: 0.95rem;
    outline: none;
    background: var(--bg-ivory);
  }

  .search-row input:focus { border-color: var(--red-accent); }

  .btn-primary {
    background: var(--red-deep);
    color: var(--white);
    border: none;
    padding: 13px 26px;
    font-size: 0.9rem;
    font-weight: 600;
    border-radius: var(--radius);
    cursor: pointer;
    transition: background 0.2s ease;
    white-space: nowrap;
  }

  .btn-primary:hover { background: var(--red-accent); }
  .btn-primary:disabled { opacity: 0.6; cursor: not-allowed; }

  .btn-outline {
    background: transparent;
    border: 1px solid var(--red-deep);
    color: var(--red-deep);
    padding: 13px 26px;
    font-size: 0.9rem;
    font-weight: 600;
    border-radius: var(--radius);
    cursor: pointer;
  }

  /* ---- QR CODE CARD ---- */
  .qr-card {
    background: var(--white);
    border: 1px solid var(--hairline);
    border-radius: var(--radius);
    padding: 28px;
    margin-bottom: 28px;
    display: flex;
    align-items: center;
    gap: 26px;
  }

  .qr-card .qr-icon {
    width: 52px;
    height: 52px;
    border-radius: 50%;
    background: var(--red-soft);
    display: flex;
    align-items: center;
    justify-content: center;
    flex: none;
  }

  .qr-card .qr-icon svg {
    width: 24px;
    height: 24px;
    color: var(--red-deep);
  }

  .qr-card .qr-copy { flex: 1; min-width: 220px; }

  .qr-card h3 {
    font-size: 1.05rem;
    color: var(--charcoal);
    margin-bottom: 3px;
  }

  .qr-card .qr-copy p {
    color: var(--grey);
    font-size: 0.86rem;
  }

  .qr-form {
    display: flex;
    gap: 12px;
    flex: none;
    width: 100%;
    max-width: 420px;
  }

  .qr-form input {
    flex: 1;
    padding: 13px 16px;
    border: 1px solid var(--hairline);
    border-radius: var(--radius);
    font-family: 'Work Sans', sans-serif;
    font-size: 0.92rem;
    outline: none;
    background: var(--bg-ivory);
  }

  .qr-form input:focus { border-color: var(--red-accent); }

  /* ---- RESULT STATES ---- */
  .result-box { display: none; }
  .result-box.active { display: block; }

  .found-card {
    background: var(--white);
    border: 1px solid var(--hairline);
    border-left: 4px solid var(--green);
    border-radius: var(--radius);
    padding: 26px 28px;
  }

  .found-card .status-tag {
    display: inline-block;
    background: #E7F0E9;
    color: var(--green);
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    padding: 4px 10px;
    border-radius: var(--radius);
    margin-bottom: 14px;
  }

  .found-card h2 { font-size: 1.25rem; margin-bottom: 4px; }
  .found-card .cnic-line { color: var(--grey); font-size: 0.88rem; margin-bottom: 18px; }

  .info-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 14px;
    font-size: 0.9rem;
  }

  .info-grid div span { display: block; color: var(--grey); font-size: 0.78rem; margin-bottom: 3px; }
  .info-grid div strong { font-weight: 600; }

  .not-found-card {
    background: var(--red-soft);
    border: 1px solid rgba(163,29,46,0.2);
    border-left: 4px solid var(--red-deep);
    border-radius: var(--radius);
    padding: 22px 28px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    flex-wrap: wrap;
  }

  .not-found-card p { font-size: 0.92rem; color: var(--red-deep); font-weight: 500; }

  /* ---- ERROR STATE ---- */
  .error-card {
    background: var(--red-soft);
    border: 1px solid rgba(163,29,46,0.2);
    border-left: 4px solid var(--red-accent);
    border-radius: var(--radius);
    padding: 18px 22px;
    font-size: 0.9rem;
    color: var(--red-deep);
    font-weight: 500;
  }

  /* ---- ADD PATIENT FORM ---- */
  .add-form-card {
    background: var(--white);
    border: 1px solid var(--hairline);
    border-radius: var(--radius);
    padding: 28px;
    margin-top: 20px;
    display: none;
  }

  .add-form-card.active { display: block; }

  .add-form-card h3 { font-size: 1.1rem; margin-bottom: 20px; color: var(--red-deep); }

  .field { margin-bottom: 18px; }
  .row-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }

  .field label { display: block; font-size: 0.82rem; font-weight: 600; margin-bottom: 8px; }

  .field input, .field select {
    width: 100%;
    padding: 12px 14px;
    border: 1px solid var(--hairline);
    border-radius: var(--radius);
    font-family: 'Work Sans', sans-serif;
    font-size: 0.92rem;
    background: var(--bg-ivory);
    outline: none;
  }

  .field input:focus, .field select:focus { border-color: var(--red-accent); }

  .form-actions { display: flex; gap: 12px; margin-top: 6px; }

  .toast {
    display: none;
    background: #E7F0E9;
    color: var(--green);
    border-left: 4px solid var(--green);
    padding: 14px 18px;
    border-radius: var(--radius);
    font-size: 0.88rem;
    font-weight: 600;
    margin-top: 20px;
  }

  .toast.active { display: block; }

  .toast.error {
    background: var(--red-soft);
    color: var(--red-deep);
    border-left-color: var(--red-accent);
  }

  /* ================= RESPONSIVE ================= */
  @media (max-width: 980px) {
    body { grid-template-columns: 1fr; }

    .mobile-bar {
      display: flex;
      align-items: center;
      justify-content: space-between;
      background: var(--red-deep);
      color: var(--white);
      padding: 16px 20px;
      position: sticky;
      top: 0;
      z-index: 30;
    }

    .mobile-bar .brand { margin-bottom: 0; font-size: 1.05rem; }
    .mobile-bar .brand .mark { width: 28px; height: 28px; }
    .mobile-bar .brand .mark svg { width: 14px; height: 14px; }

    .menu-toggle {
      background: rgba(255,255,255,0.12);
      border: 1px solid rgba(255,255,255,0.25);
      border-radius: 6px;
      width: 38px;
      height: 38px;
      display: flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      flex: none;
    }
    .menu-toggle svg { width: 18px; height: 18px; }

    .sidebar {
      position: fixed;
      top: 0;
      left: 0;
      height: 100vh;
      width: var(--sidebar-w-mobile);
      max-width: 320px;
      transform: translateX(-100%);
      transition: transform 0.25s ease;
      z-index: 50;
    }

    .sidebar.open { transform: translateX(0); }

    .sidebar-backdrop {
      display: block;
      position: fixed;
      inset: 0;
      background: rgba(20, 8, 10, 0.45);
      opacity: 0;
      pointer-events: none;
      transition: opacity 0.25s ease;
      z-index: 40;
    }

    .sidebar-backdrop.open { opacity: 1; pointer-events: auto; }

    main { padding: 28px 20px 44px; }
  }

  @media (max-width: 640px) {
    .qr-card { flex-direction: column; align-items: flex-start; }
    .qr-form { max-width: none; flex-direction: column; }
  }

  @media (max-width: 560px) {
    .info-grid { grid-template-columns: 1fr; }
    .row-2 { grid-template-columns: 1fr; }
    .search-row { flex-direction: column; }
    .not-found-card { flex-direction: column; align-items: flex-start; }
  }
</style>
</head>
<body>

  <!-- mobile top bar: presentational only, no logic touched -->
  <div class="mobile-bar">
    <div class="brand">
      <span class="mark">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M12 3v18M3 12h18"/></svg>
      </span>
      <span>Alshifa Clinic</span>
    </div>
    <button class="menu-toggle" id="menuToggle" aria-label="Open menu" onclick="toggleSidebar(true)">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
    </button>
  </div>

  <div class="sidebar-backdrop" id="sidebarBackdrop" onclick="toggleSidebar(false)"></div>

  <aside class="sidebar" id="sidebar">
    <div class="brand">
      <span class="mark">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M12 3v18M3 12h18"/></svg>
      </span>
      <span class="brand-text">
        Alshifa Clinic
        <small>Front Desk</small>
      </span>
    </div>

    <div class="sidebar-scroll">
      <div class="nav-label">Workspace</div>
      <nav>
        <ul>
          <li>
            <a href="#" class="active">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="7"/><path d="M21 21l-4.3-4.3"/></svg>
              Find / Add Patient
            </a>
          </li>
          <li>
            <a href="#">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="17" rx="2"/><path d="M8 2v4M16 2v4M3 10h18"/></svg>
              Today's Appointments
            </a>
          </li>
          <li>
            <a href="#">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H7a4 4 0 0 0-4 4v2"/><circle cx="10" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
              All Patients
            </a>
          </li>
        </ul>
      </nav>

      <div class="nav-divider"></div>

      <nav>
        <ul>
          <li>
            <a href="#">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg>
              Settings
            </a>
          </li>
        </ul>
      </nav>
    </div>

    <div class="staff-tag">
      <span class="avatar" id="staffAvatar">RS</span>
      <div class="staff-meta">
        <strong><%- username %></strong>
        <span>Receptionist — Front Desk</span>
      </div>
    </div>
  </aside>

  <main>
    <div class="page-head">
      <span class="eyebrow">Receptionist Panel</span>
      <h1>Find or Register a Patient</h1>
      <p>Search by CNIC to check if a patient record already exists before creating a new one.</p>
    </div>
    
    <div class="search-card">
      <div class="search-row">
        <input type="text" id="cnicSearch" placeholder="Enter CNIC — e.g. 4210112345671">
        <button class="btn-primary" id="searchBtn" onclick="searchPatient()">Search</button>
      </div>
    </div>

    <div class="qr-card">
      <span class="qr-icon">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
          <rect x="3" y="3" width="7" height="7" rx="1"/>
          <rect x="14" y="3" width="7" height="7" rx="1"/>
          <rect x="3" y="14" width="7" height="7" rx="1"/>
          <path d="M14 14h3v3h-3zM19 14h2v2h-2zM14 19h2v2h-2zM19 19h2v2h-2z"/>
        </svg>
      </span>
      <div class="qr-copy">
        <h3>Generate QR Code</h3>
        <p>Print a scannable code linked to a patient's CNIC for quick check-in.</p>
      </div>
      <form action="/generate-qr" method="post" class="qr-form">
        <input type="text" placeholder="Enter CNIC to generate QR code" name="cnic">
        <button class="btn-primary" type="submit">Generate</button>
      </form>
    </div>

    <div id="foundResult" class="result-box">
      <div class="found-card">
        <span class="status-tag">Record Found</span>
        <h2 id="foundName"></h2>
        <p class="cnic-line" id="foundCnic"></p>
        <div class="info-grid">
          <div><span>Phone</span><strong id="foundPhone"></strong></div>
          <div><span>Gender</span><strong id="foundGender"></strong></div>
          <div><span>Age</span><strong id="foundAge"></strong></div>
          <div><span>Last Visit</span><strong id="foundVisit"></strong></div>
        </div>
      </div>
    </div>

    <div id="notFoundResult" class="result-box">
      <div class="not-found-card">
        <p>No patient found with this CNIC. You can add a new record below.</p>
        <button class="btn-outline" onclick="toggleAddForm(true)">+ Add New Patient</button>
      </div>
    </div>

    <div id="errorResult" class="result-box">
      <div class="error-card" id="errorText"></div>
    </div>

    <div class="add-form-card" id="addFormCard">
      <h3>New Patient Record</h3>
      <form id="addPatientForm">
        <div class="field">
          <label for="pName">Full Name</label>
          <input type="text" id="pName" required>
        </div>
        <div class="row-2">
          <div class="field">
            <label for="pCnic">CNIC</label>
            <input type="text" id="pCnic" required>
          </div>
          <div class="field">
            <label for="pPhone">Phone</label>
            <input type="tel" id="pPhone" required>
          </div>
        </div>
        <div class="row-2">
          <div class="field">
            <label for="pGender">Gender</label>
            <select id="pGender">
              <option value="female">Female</option>
              <option value="male">Male</option>
              <option value="other">Other</option>
            </select>
          </div>
          <div class="field">
            <label for="pAge">Age</label>
            <input type="number" id="pAge" min="0">
          </div>
        </div>
        <div class="form-actions">
          <button type="submit" class="btn-primary" id="saveBtn">Save Patient Record</button>
          <button type="button" class="btn-outline" onclick="toggleAddForm(false)">Cancel</button>
        </div>
      </form>
      <div class="toast" id="saveToast"></div>
    </div>
  </main>

  <script>
    const API_BASE = '/api/patients'; // adjust if your API is mounted elsewhere

    const foundResult = document.getElementById('foundResult');
    const notFoundResult = document.getElementById('notFoundResult');
    const errorResult = document.getElementById('errorResult');
    const errorText = document.getElementById('errorText');
    const addFormCard = document.getElementById('addFormCard');
    const searchBtn = document.getElementById('searchBtn');
    const saveBtn = document.getElementById('saveBtn');
    const saveToast = document.getElementById('saveToast');

    function hideAllResults() {
      foundResult.classList.remove('active');
      notFoundResult.classList.remove('active');
      errorResult.classList.remove('active');
      addFormCard.classList.remove('active');
      saveToast.classList.remove('active', 'error');
    }

    async function searchPatient() {
      const cnic = document.getElementById('cnicSearch').value.trim();
      hideAllResults();

      if (!cnic) return;

      searchBtn.disabled = true;
      searchBtn.textContent = 'Searching...';

      try {
        const res = await fetch(`${API_BASE}/${encodeURIComponent(cnic)}`, {
          method: 'GET',
          headers: { 'Content-Type': 'application/json' },
          credentials: 'include' // send auth cookie/session
        });

        if (res.status === 404) {
          document.getElementById('pCnic').value = cnic;
          notFoundResult.classList.add('active');
          return;
        }

        if (!res.ok) {
          throw new Error(`Server responded with ${res.status}`);
        }

        const data = await res.json();
        const patient = data.patient || data; // handle either { patient: {...} } or flat response

        document.getElementById('foundName').textContent = patient.name;
        document.getElementById('foundCnic').textContent = "CNIC: " + patient.cnic;
        document.getElementById('foundPhone').textContent = patient.phone || '—';
        document.getElementById('foundGender').textContent = patient.gender || '—';
        document.getElementById('foundAge').textContent = patient.age ?? '—';
        document.getElementById('foundVisit').textContent = patient.lastVisit || 'No visits yet';
        foundResult.classList.add('active');

      } catch (err) {
        console.error('Search error:', err);
        errorText.textContent = 'Could not reach the server. Please try again.';
        errorResult.classList.add('active');
      } finally {
        searchBtn.disabled = false;
        searchBtn.textContent = 'Search';
      }
    }

    function toggleAddForm(show) {
      addFormCard.classList.toggle('active', show);
    }

    document.getElementById('addPatientForm').addEventListener('submit', async function (e) {
      e.preventDefault();

      const payload = {
        name: document.getElementById('pName').value.trim(),
        cnic: document.getElementById('pCnic').value.trim(),
        phone: document.getElementById('pPhone').value.trim(),
        gender: document.getElementById('pGender').value,
        age: document.getElementById('pAge').value ? Number(document.getElementById('pAge').value) : undefined
      };

      saveBtn.disabled = true;
      saveBtn.textContent = 'Saving...';
      saveToast.classList.remove('active', 'error');

      try {
        const res = await fetch(API_BASE, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          credentials: 'include',
          body: JSON.stringify(payload)
        });

        const data = await res.json();

        if (!res.ok) {
          throw new Error(data.message || `Server responded with ${res.status}`);
        }

        saveToast.textContent = 'Patient record saved successfully.';
        saveToast.classList.add('active');
        this.reset();

      } catch (err) {
        console.error('Save error:', err);
        saveToast.textContent = err.message || 'Failed to save patient record.';
        saveToast.classList.add('active', 'error');
      } finally {
        saveBtn.disabled = false;
        saveBtn.textContent = 'Save Patient Record';
      }
    });

    /* ---- sidebar drawer toggle — presentational only, additive ---- */
    const sidebarEl = document.getElementById('sidebar');
    const sidebarBackdrop = document.getElementById('sidebarBackdrop');

    function toggleSidebar(open) {
      sidebarEl.classList.toggle('open', open);
      sidebarBackdrop.classList.toggle('open', open);
    }

    window.addEventListener('resize', () => {
      if (window.innerWidth > 980) toggleSidebar(false);
    });

    (function setAvatarInitials() {
      const el = document.querySelector('.staff-tag strong');
      const avatar = document.getElementById('staffAvatar');
      if (!el || !avatar) return;
      const name = el.textContent.trim();
      if (!name) return;
      const initials = name.split(/\s+/).slice(0, 2).map(w => w[0]).join('').toUpperCase();
      if (initials) avatar.textContent = initials;
    })();
  </script>

</body>
</html>