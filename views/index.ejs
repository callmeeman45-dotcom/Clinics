<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Alshifa Clinic — Trusted Care, Every Visit</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600;9..144,700&family=Work+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
<style>
  :root {
    --bg-ivory: #FBF8F5;
    --white: #FFFFFF;
    --red-deep: #6E1423;
    --red-accent: #A31D2E;
    --red-soft: #F4E3E1;
    --charcoal: #201C1B;
    --grey: #6B615E;
    --hairline: rgba(32, 28, 27, 0.12);
    --radius: 2px;
  }

  * { margin: 0; padding: 0; box-sizing: border-box; }

  html { scroll-behavior: smooth; }

  body {
    background: var(--bg-ivory);
    color: var(--charcoal);
    font-family: 'Work Sans', sans-serif;
    line-height: 1.6;
  }

  h1, h2, h3, .brand {
    font-family: 'Fraunces', serif;
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  a { color: inherit; text-decoration: none; }

  .container {
    max-width: 1180px;
    margin: 0 auto;
    padding: 0 32px;
  }

  /* ---------- HEADER ---------- */
  header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: rgba(251, 248, 245, 0.92);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--hairline);
  }

  .nav-wrap {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 20px 32px;
    max-width: 1180px;
    margin: 0 auto;
  }

  .brand {
    font-size: 1.5rem;
    color: var(--red-deep);
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .brand .mark {
    width: 10px;
    height: 10px;
    background: var(--red-accent);
    border-radius: 50%;
    display: inline-block;
  }

  nav ul {
    display: flex;
    gap: 36px;
    list-style: none;
  }

  nav a {
    font-size: 0.92rem;
    font-weight: 500;
    color: var(--charcoal);
    position: relative;
    padding-bottom: 4px;
  }

  nav a:hover { color: var(--red-deep); }

  .btn-primary {
    background: var(--red-deep);
    color: var(--white);
    padding: 12px 26px;
    font-size: 0.88rem;
    font-weight: 600;
    border-radius: var(--radius);
    letter-spacing: 0.02em;
    transition: background 0.25s ease;
    display: inline-block;
    border: 1px solid var(--red-deep);
  }

  .btn-primary:hover { background: var(--red-accent); border-color: var(--red-accent); }

  .btn-outline {
    border: 1px solid var(--white);
    color: var(--white);
    padding: 12px 26px;
    font-size: 0.88rem;
    font-weight: 600;
    border-radius: var(--radius);
    display: inline-block;
  }

  .btn-outline:hover { background: rgba(255,255,255,0.12); }

  @media (max-width: 860px) {
    nav ul { display: none; }
  }

  /* ---------- HERO ---------- */
  .hero {
    position: relative;
    min-height: 88vh;
    display: flex;
    align-items: center;
    background:
      linear-gradient(100deg, rgba(30,10,14,0.88) 10%, rgba(110,20,35,0.55) 55%, rgba(110,20,35,0.25) 100%),
      url('https://images.unsplash.com/photo-1519494026892-80bbd2d6fd0d?auto=format&fit=crop&w=1600&q=80') center/cover no-repeat;
    color: var(--white);
  }

  .hero-content {
    max-width: 1000px;
    padding: 4px 50px;
  }

  .eyebrow {
    text-transform: uppercase;
    letter-spacing: 0.18em;
    font-size: 0.75rem;
    font-weight: 600;
    color: #E7B9BE;
    margin-bottom: 22px;
    display: block;
  }

  .hero h1 {
    font-size: clamp(2.4rem, 4.6vw, 3.6rem);
    line-height: 1.12;
    margin-bottom: 22px;
  }

  .hero p {
    font-size: 1.05rem;
    color: #EFE3E1;
    max-width: 480px;
    margin-bottom: 36px;
  }

  .hero-cta { display: flex; gap: 16px; flex-wrap: wrap; }

  .hero-stats {
    display: flex;
    gap: 40px;
    margin-top: 56px;
    padding-top: 28px;
    border-top: 1px solid rgba(255,255,255,0.22);
    max-width: 480px;
  }

  .hero-stats div strong {
    font-family: 'Fraunces', serif;
    font-size: 1.6rem;
    display: block;
    color: var(--white);
  }

  .hero-stats div span {
    font-size: 0.8rem;
    color: #E7CFCF;
  }

  /* ---------- SECTION SHARED ---------- */
  section { padding: 100px 0; }

  .section-head {
    text-align: center;
    max-width: 560px;
    margin: 0 auto 56px;
  }

  .section-head .eyebrow { color: var(--red-accent); text-align: center; }

  .section-head h2 {
    font-size: clamp(1.8rem, 3vw, 2.4rem);
    color: var(--charcoal);
    margin-bottom: 14px;
  }

  .section-head p { color: var(--grey); font-size: 0.98rem; }

  /* ---------- DOCTORS ---------- */
  .doctors-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 28px;
  }

  .doctor-card {
    background: var(--white);
    border: 1px solid var(--hairline);
    border-radius: var(--radius);
    overflow: hidden;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
    position: relative;
  }

  .doctor-card:hover {
    transform: translateY(-6px);
    box-shadow: 0 18px 40px rgba(110,20,35,0.14);
  }

  .doctor-photo {
    height: 260px;
    background-size: cover;
    background-position: center;
    position: relative;
  }

  .doctor-tag {
    position: absolute;
    top: 16px;
    left: 16px;
    background: var(--red-deep);
    color: var(--white);
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    padding: 5px 12px;
    border-radius: var(--radius);
    text-transform: uppercase;
  }

  .doctor-info { padding: 22px 22px 26px; }

  .doctor-info h3 { font-size: 1.15rem; color: var(--charcoal); margin-bottom: 4px; }

  .doctor-info .specialty {
    color: var(--red-accent);
    font-size: 0.85rem;
    font-weight: 600;
    margin-bottom: 10px;
  }

  .doctor-info .meta {
    color: var(--grey);
    font-size: 0.85rem;
    display: flex;
    justify-content: space-between;
    border-top: 1px dashed var(--hairline);
    padding-top: 12px;
    margin-top: 12px;
  }

  /* ---------- BOOKING STEPS ---------- */
  .booking {
    background: var(--red-deep);
    color: var(--white);
  }

  .booking .section-head .eyebrow { color: #E7B9BE; }
  .booking .section-head h2 { color: var(--white); }
  .booking .section-head p { color: #E7CFCF; }

  .steps-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 0;
    position: relative;
  }

  .step {
    padding: 0 22px;
    position: relative;
  }

  .step::before {
    content: '';
    position: absolute;
    top: 22px;
    left: -14px;
    width: 1px;
    height: calc(100% - 22px);
    background: rgba(255,255,255,0.18);
  }

  .step:first-child::before { display: none; }

  .step-num {
    font-family: 'Fraunces', serif;
    font-size: 2.2rem;
    color: #E7B9BE;
    margin-bottom: 14px;
  }

  .step h3 { font-size: 1.05rem; margin-bottom: 10px; color: var(--white); }
  .step p { color: #E7CFCF; font-size: 0.9rem; }

  @media (max-width: 900px) {
    .steps-grid { grid-template-columns: repeat(2, 1fr); gap: 40px 20px; }
    .step::before { display: none; }
    .doctors-grid { grid-template-columns: repeat(2, 1fr); }
  }

  @media (max-width: 600px) {
    .steps-grid { grid-template-columns: 1fr; }
    .doctors-grid { grid-template-columns: 1fr; }
  }

  /* ---------- HOURS + CONTACT ---------- */
  .hours-wrap {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: 60px;
    align-items: center;
  }

  .hours-list { border-top: 1px solid var(--hairline); }

  .hours-row {
    display: flex;
    justify-content: space-between;
    padding: 16px 0;
    border-bottom: 1px solid var(--hairline);
    font-size: 0.95rem;
  }

  .hours-row .day { font-weight: 600; color: var(--charcoal); }
  .hours-row .time { color: var(--grey); }
  .hours-row.closed .time { color: var(--red-accent); }

  .contact-card {
    background: var(--white);
    border: 1px solid var(--hairline);
    padding: 36px;
    border-radius: var(--radius);
  }

  .contact-card h3 { font-size: 1.2rem; margin-bottom: 18px; color: var(--red-deep); }

  .contact-row {
    display: flex;
    justify-content: space-between;
    padding: 12px 0;
    border-bottom: 1px dashed var(--hairline);
    font-size: 0.92rem;
  }

  .contact-row span:first-child { color: var(--grey); }
  .contact-row span:last-child { font-weight: 600; }

  /* ---------- FOOTER ---------- */
  footer {
    background: var(--charcoal);
    color: #D9D2D0;
    padding: 60px 0 28px;
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 1.4fr 1fr 1fr 1fr;
    gap: 40px;
    margin-bottom: 48px;
  }

  footer .brand { color: var(--white); margin-bottom: 14px; }
  footer .brand .mark { background: var(--red-accent); }

  footer p.desc { font-size: 0.88rem; color: #A79E9C; max-width: 280px; }

  footer h4 {
    color: var(--white);
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin-bottom: 18px;
  }

  footer ul { list-style: none; }
  footer li { margin-bottom: 10px; font-size: 0.88rem; }
  footer a:hover { color: var(--red-accent); }

  .footer-bottom {
    border-top: 1px solid rgba(255,255,255,0.1);
    padding-top: 24px;
    display: flex;
    justify-content: space-between;
    font-size: 0.8rem;
    color: #8A817F;
    flex-wrap: wrap;
    gap: 10px;
  }

  @media (max-width: 800px) {
    .hours-wrap { grid-template-columns: 1fr; }
    .footer-grid { grid-template-columns: 1fr 1fr; }
  }
</style>
</head>
<body>

<header>
  <div class="nav-wrap">
    <a href="#" class="brand"><span class="mark"></span>Alshifa Clinic</a>
    <nav>
