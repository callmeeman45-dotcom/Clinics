<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Alshifa Clinic — Trusted Care, Every Visit</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600;9..144,700&family=Work+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
<style>
  :root {
    --bg-ivory: #FBF8F5;
    --white: #FFFFFF;
    --red-deep: #6E1423;
    --red-accent: #A31D2E;
    --red-soft: #F4E3E1;
    --charcoal: #201C1B;
    --grey: #6B615E;
    --hairline: rgba(32, 28, 27, 0.12);
    --radius: 2px;
  }

  * { margin: 0; padding: 0; box-sizing: border-box; }

  html { scroll-behavior: smooth; }

  body {
    background: var(--bg-ivory);
    color: var(--charcoal);
    font-family: 'Work Sans', sans-serif;
    line-height: 1.6;
    overflow-x: hidden;
  }

  img { max-width: 100%; display: block; }

  h1, h2, h3, .brand {
    font-family: 'Fraunces', serif;
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  a { color: inherit; text-decoration: none; }

  .container {
    max-width: 1180px;
    margin: 0 auto;
    padding: 0 clamp(20px, 5vw, 32px);
  }

  /* ---------- HEADER ---------- */
  header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: rgba(251, 248, 245, 0.92);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--hairline);
  }

  .nav-wrap {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 18px clamp(20px, 5vw, 32px);
    max-width: 1180px;
    margin: 0 auto;
    position: relative;
  }

  .brand {
    font-size: clamp(1.2rem, 3vw, 1.5rem);
    color: var(--red-deep);
    display: flex;
    align-items: center;
    gap: 10px;
    white-space: nowrap;
  }

  .brand .mark {
    width: 10px;
    height: 10px;
    background: var(--red-accent);
    border-radius: 50%;
    display: inline-block;
    flex-shrink: 0;
  }

  nav ul {
    display: flex;
    gap: 36px;
    list-style: none;
  }

  nav a {
    font-size: 0.92rem;
    font-weight: 500;
    color: var(--charcoal);
    position: relative;
    padding-bottom: 4px;
  }

  nav a:hover { color: var(--red-deep); }

  .btn-primary {
    background: var(--red-deep);
    color: var(--white);
    padding: 12px 26px;
    font-size: 0.88rem;
    font-weight: 600;
    border-radius: var(--radius);
    letter-spacing: 0.02em;
    transition: background 0.25s ease;
    display: inline-block;
    border: 1px solid var(--red-deep);
    cursor: pointer;
    text-align: center;
  }

  .btn-primary:hover { background: var(--red-accent); border-color: var(--red-accent); }

  .btn-outline {
    border: 1px solid var(--white);
    color: var(--white);
    padding: 12px 26px;
    font-size: 0.88rem;
    font-weight: 600;
    border-radius: var(--radius);
    display: inline-block;
    text-align: center;
  }

  .btn-outline:hover { background: rgba(255,255,255,0.12); }

  /* Hamburger button — hidden on desktop */
  .menu-toggle {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 32px;
    height: 32px;
    background: none;
    border: none;
    cursor: pointer;
    z-index: 200;
  }

  .menu-toggle span {
    display: block;
    width: 100%;
    height: 2px;
    background: var(--charcoal);
    transition: transform 0.25s ease, opacity 0.25s ease;
  }

  .menu-toggle.open span:nth-child(1) { transform: translateY(7px) rotate(45deg); }
  .menu-toggle.open span:nth-child(2) { opacity: 0; }
  .menu-toggle.open span:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }

  .nav-cta-desktop { display: inline-block; }

  @media (max-width: 860px) {
    .menu-toggle { display: flex; }

    nav {
      position: fixed;
      top: 0;
      right: 0;
      height: 100vh;
      width: min(78vw, 320px);
      background: var(--bg-ivory);
      box-shadow: -8px 0 30px rgba(0,0,0,0.12);
      transform: translateX(100%);
      transition: transform 0.3s ease;
      padding: 90px 32px 32px;
      z-index: 150;
    }

    nav.open { transform: translateX(0); }

    nav ul {
      flex-direction: column;
      gap: 26px;
    }

    nav a { font-size: 1.05rem; }

    .nav-cta-mobile {
      margin-top: 36px;
      display: inline-block;
      width: 100%;
    }

    .nav-cta-desktop { display: none; }

    .nav-overlay {
      display: none;
      position: fixed;
      inset: 0;
      background: rgba(0,0,0,0.35);
      z-index: 120;
    }

    .nav-overlay.open { display: block; }
  }

  /* ---------- HERO ---------- */
  .hero {
    position: relative;
    min-height: 88vh;
    display: flex;
    align-items: center;
    background:
      linear-gradient(100deg, rgba(30,10,14,0.88) 10%, rgba(110,20,35,0.55) 55%, rgba(110,20,35,0.25) 100%),
      url('https://images.unsplash.com/photo-1519494026892-80bbd2d6fd0d?auto=format&fit=crop&w=1600&q=80') center/cover no-repeat;
    color: var(--white);
    padding: 60px 0;
  }

  .hero-content {
    max-width: 1000px;
    padding: 4px clamp(20px, 6vw, 50px);
    width: 100%;
  }

  .eyebrow {
    text-transform: uppercase;
    letter-spacing: 0.18em;
    font-size: 0.75rem;
    font-weight: 600;
    color: #E7B9BE;
    margin-bottom: 22px;
    display: block;
  }

  .hero h1 {
    font-size: clamp(2rem, 6vw, 3.6rem);
    line-height: 1.15;
    margin-bottom: 22px;
  }

  .hero p {
    font-size: clamp(0.95rem, 2.2vw, 1.05rem);
    color: #EFE3E1;
    max-width: 480px;
    margin-bottom: 36px;
  }

  .hero-cta { display: flex; gap: 16px; flex-wrap: wrap; }
  .hero-cta a { flex: 1 1 200px; }

  .hero-stats {
    display: flex;
    gap: clamp(20px, 5vw, 40px);
    margin-top: 56px;
    padding-top: 28px;
    border-top: 1px solid rgba(255,255,255,0.22);
    max-width: 480px;
    flex-wrap: wrap;
  }

  .hero-stats div strong {
    font-family: 'Fraunces', serif;
    font-size: clamp(1.3rem, 3vw, 1.6rem);
    display: block;
    color: var(--white);
  }

  .hero-stats div span {
    font-size: 0.8rem;
    color: #E7CFCF;
  }

  @media (max-width: 480px) {
    .hero { min-height: auto; padding: 80px 0 60px; }
    .hero-cta { flex-direction: column; }
    .hero-cta a { flex: none; width: 100%; }
  }

  /* ---------- SECTION SHARED ---------- */
  section { padding: clamp(60px, 10vw, 100px) 0; }

  .section-head {
    text-align: center;
    max-width: 560px;
    margin: 0 auto clamp(36px, 6vw, 56px);
    padding: 0 12px;
  }

  .section-head .eyebrow { color: var(--red-accent); text-align: center; }

  .section-head h2 {
    font-size: clamp(1.6rem, 4vw, 2.4rem);
    color: var(--charcoal);
    margin-bottom: 14px;
  }

  .section-head p { color: var(--grey); font-size: 0.98rem; }

  /* ---------- DOCTORS ---------- */
  .doctors-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 28px;
  }

  .doctor-card {
    background: var(--white);
    border: 1px solid var(--hairline);
    border-radius: var(--radius);
    overflow: hidden;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
    position: relative;
  }

  .doctor-card:hover {
    transform: translateY(-6px);
    box-shadow: 0 18px 40px rgba(110,20,35,0.14);
  }

  .doctor-photo {
    height: 260px;
    background-size: cover;
    background-position: center;
    position: relative;
  }

  .doctor-tag {
    position: absolute;
    top: 16px;
    left: 16px;
    background: var(--red-deep);
    color: var(--white);
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    padding: 5px 12px;
    border-radius: var(--radius);
    text-transform: uppercase;
  }

  .doctor-info { padding: 22px 22px 26px; }

  .doctor-info h3 { font-size: 1.15rem; color: var(--charcoal); margin-bottom: 4px; }

  .doctor-info .specialty {
    color: var(--red-accent);
    font-size: 0.85rem;
    font-weight: 600;
    margin-bottom: 10px;
  }

  .doctor-info .meta {
    color: var(--grey);
    font-size: 0.85rem;
    display: flex;
    justify-content: space-between;
    border-top: 1px dashed var(--hairline);
    padding-top: 12px;
    margin-top: 12px;
    flex-wrap: wrap;
    gap: 6px;
  }

  /* ---------- BOOKING STEPS ---------- */
  .booking {
    background: var(--red-deep);
    color: var(--white);
  }

  .booking .section-head .eyebrow { color: #E7B9BE; }
  .booking .section-head h2 { color: var(--white); }
  .booking .section-head p { color: #E7CFCF; }

  .steps-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 0;
    position: relative;
  }

  .step {
    padding: 0 22px;
    position: relative;
  }

  .step::before {
    content: '';
    position: absolute;
    top: 22px;
    left: -14px;
    width: 1px;
    height: calc(100% - 22px);
    background: rgba(255,255,255,0.18);
  }

  .step:first-child::before { display: none; }

  .step-num {
    font-family: 'Fraunces', serif;
    font-size: clamp(1.8rem, 4vw, 2.2rem);
    color: #E7B9BE;
    margin-bottom: 14px;
  }

  .step h3 { font-size: 1.05rem; margin-bottom: 10px; color: var(--white); }
  .step p { color: #E7CFCF; font-size: 0.9rem; }

  @media (max-width: 900px) {
    .steps-grid { grid-template-columns: repeat(2, 1fr); gap: 40px 20px; }
    .step::before { display: none; }
    .doctors-grid { grid-template-columns: repeat(2, 1fr); }
  }

  @media (max-width: 600px) {
    .steps-grid { grid-template-columns: 1fr; }
    .doctors-grid { grid-template-columns: 1fr; }
    .doctor-photo { height: 220px; }
  }

  /* ---------- HOURS + CONTACT ---------- */
  .hours-wrap {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: clamp(30px, 6vw, 60px);
    align-items: center;
  }

  .hours-list { border-top: 1px solid var(--hairline); }

  .hours-row {
    display: flex;
    justify-content: space-between;
    padding: 16px 0;
    border-bottom: 1px solid var(--hairline);
    font-size: 0.95rem;
    flex-wrap: wrap;
    gap: 6px;
  }

  .hours-row .day { font-weight: 600; color: var(--charcoal); }
  .hours-row .time { color: var(--grey); }
  .hours-row.closed .time { color: var(--red-accent); }

  .contact-card {
    background: var(--white);
    border: 1px solid var(--hairline);
    padding: clamp(24px, 5vw, 36px);
    border-radius: var(--radius);
  }

  .contact-card h3 { font-size: 1.2rem; margin-bottom: 18px; color: var(--red-deep); }

  .contact-row {
    display: flex;
    justify-content: space-between;
    padding: 12px 0;
    border-bottom: 1px dashed var(--hairline);
    font-size: 0.92rem;
    flex-wrap: wrap;
    gap: 6px;
  }

  .contact-row span:first-child { color: var(--grey); }
  .contact-row span:last-child { font-weight: 600; }

  /* ---------- FOOTER ---------- */
  footer {
    background: var(--charcoal);
    color: #D9D2D0;
    padding: clamp(40px, 8vw, 60px) 0 28px;
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 1.4fr 1fr 1fr 1fr;
    gap: 40px;
    margin-bottom: 48px;
  }

  footer .brand { color: var(--white); margin-bottom: 14px; }
  footer .brand .mark { background: var(--red-accent); }

  footer p.desc { font-size: 0.88rem; color: #A79E9C; max-width: 280px; }

  footer h4 {
    color: var(--white);
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin-bottom: 18px;
  }

  footer ul { list-style: none; }
  footer li { margin-bottom: 10px; font-size: 0.88rem; word-break: break-word; }
  footer a:hover { color: var(--red-accent); }

  .footer-bottom {
    border-top: 1px solid rgba(255,255,255,0.1);
    padding-top: 24px;
    display: flex;
    justify-content: space-between;
    font-size: 0.8rem;
    color: #8A817F;
    flex-wrap: wrap;
    gap: 10px;
  }

  @media (max-width: 800px) {
    .hours-wrap { grid-template-columns: 1fr; }
    .footer-grid { grid-template-columns: 1fr 1fr; gap: 30px; }
  }

  @media (max-width: 480px) {
    .footer-grid { grid-template-columns: 1fr; text-align: left; }
    .footer-bottom { flex-direction: column; text-align: center; }
  }
</style>
</head>
<body>

<header>
  <div class="nav-wrap">
    <a href="#" class="brand"><span class="mark"></span>Alshifa Clinic</a>

    <button class="menu-toggle" id="menuToggle" aria-label="Toggle menu">
      <span></span><span></span><span></span>
    </button>

    <nav id="siteNav">
      <ul>
        <li><a href="#doctors">Our Doctors</a></li>
        <li><a href="#booking">Book Appointment</a></li>
        <li><a href="#hours">Timings</a></li>
        <li><a href="/login">login</a></li>
      </ul>
      <a href="#booking" class="btn-primary nav-cta-mobile">Book Appointment</a>
    </nav>

    <div class="nav-overlay" id="navOverlay"></div>

    <a href="#booking" class="btn-primary nav-cta-desktop">Book Appointment</a>
  </div>
</header>

<section class="hero">
  <div class="hero-content">
    <span class="eyebrow">Faisalabad's Trusted Care Centre</span>
    <h1>Care that remembers every visit, not just the last one.</h1>
    <p>From your first consultation to every follow-up, your complete medical history stays with you — accessible anytime, shared with any doctor you choose.</p>
    <div class="hero-cta">
      <a href="#booking" class="btn-primary" style="background: var(--red-accent); border-color: var(--red-accent);">Book an Appointment</a>
      <a href="#doctors" class="btn-outline">Meet Our Doctors</a>
    </div>
    <div class="hero-stats">
      <div><strong>12+</strong><span>Specialist Doctors</span></div>
      <div><strong>18k+</strong><span>Patients Treated</span></div>
      <div><strong>9</strong><span>Years of Service</span></div>
    </div>
  </div>
</section>

<section id="doctors">
  <div class="container">
    <div class="section-head">
      <span class="eyebrow">Our Specialists</span>
      <h2>Doctors you can build a history with</h2>
      <p>Every consultation is logged to your patient record — so your next doctor already knows your story.</p>
    </div>
    <div class="doctors-grid">
      <div class="doctor-card">
        <div class="doctor-photo" style="background-image:url('https://images.unsplash.com/photo-1622253692010-333f2da6031d?auto=format&fit=crop&w=500&q=80');">
          <span class="doctor-tag">Cardiologist</span>
        </div>
        <div class="doctor-info">
          <h3>Dr. Ahmed Raza</h3>
          <div class="specialty">MBBS, FCPS Cardiology</div>
          <div class="meta"><span>15 yrs experience</span><span>Mon–Fri</span></div>
        </div>
      </div>
      <div class="doctor-card">
        <div class="doctor-photo" style="background-image:url('https://images.unsplash.com/photo-1594824476967-48c8b964273f?auto=format&fit=crop&w=500&q=80');">
          <span class="doctor-tag">Dermatologist</span>
        </div>
        <div class="doctor-info">
          <h3>Dr. Sana Malik</h3>
          <div class="specialty">MBBS, DDV Skin & Care</div>
          <div class="meta"><span>10 yrs experience</span><span>Tue–Sat</span></div>
        </div>
      </div>
      <div class="doctor-card">
        <div class="doctor-photo" style="background-image:url('https://images.unsplash.com/photo-1537368910025-700350fe46c7?auto=format&fit=crop&w=500&q=80');">
          <span class="doctor-tag">Pediatrician</span>
        </div>
        <div class="doctor-info">
          <h3>Dr. Bilal Hussain</h3>
          <div class="specialty">MBBS, FCPS Child Health</div>
          <div class="meta"><span>12 yrs experience</span><span>Mon–Sat</span></div>
        </div>
      </div>
    </div>
  </div>
</section>

<section class="booking" id="booking">
  <div class="container">
    <div class="section-head">
      <span class="eyebrow">Getting an Appointment</span>
      <h2>Four steps to your visit</h2>
      <p>No paper slips, no lost prescriptions — just a simple, guided path to seeing your doctor.</p>
    </div>
    <div class="steps-grid">
      <div class="step">
        <div class="step-num">01</div>
        <h3>Choose a Doctor</h3>
        <p>Browse specialists by department and pick who fits your need.</p>
      </div>
      <div class="step">
        <div class="step-num">02</div>
        <h3>Pick a Slot</h3>
        <p>Select an available date and time that suits your schedule.</p>
      </div>
      <div class="step">
        <div class="step-num">03</div>
        <h3>Confirm Details</h3>
        <p>Add your CNIC and contact info — returning patients skip this.</p>
      </div>
      <div class="step">
        <div class="step-num">04</div>
        <h3>Visit & Get Recorded</h3>
        <p>Your prescription and history are saved to your account automatically.</p>
      </div>
    </div>
  </div>
</section>

<section id="hours">
  <div class="container">
    <div class="section-head">
      <span class="eyebrow">Visit Us</span>
      <h2>Clinic timings & contact</h2>
    </div>
    <div class="hours-wrap">
      <div class="hours-list">
        <div class="hours-row"><span class="day">Monday – Friday</span><span class="time">9:00 AM – 9:00 PM</span></div>
        <div class="hours-row"><span class="day">Saturday</span><span class="time">10:00 AM – 6:00 PM</span></div>
        <div class="hours-row closed"><span class="day">Sunday</span><span class="time">Closed</span></div>
        <div class="hours-row"><span class="day">Emergency Desk</span><span class="time">24/7 Available</span></div>
      </div>
      <div class="contact-card">
        <h3>Contact Details</h3>
        <div class="contact-row"><span>Phone</span><span>+92 300 1234567</span></div>
        <div class="contact-row"><span>Email</span><span>info@alshifaclinic.pk</span></div>
        <div class="contact-row"><span>Address</span><span>Susan Road, Faisalabad</span></div>
        <a href="#booking" class="btn-primary" style="width:100%; text-align:center; margin-top:20px;">Book Now</a>
      </div>
    </div>
  </div>
</section>

<footer>
  <div class="container">
    <div class="footer-grid">
      <div>
        <a href="#" class="brand"><span class="mark"></span>Alshifa Clinic</a>
        <p class="desc">Keeping your medical history in one place — for every doctor, every visit, every time.</p>
      </div>
      <div>
        <h4>Explore</h4>
        <ul>
          <li><a href="#doctors">Our Doctors</a></li>
          <li><a href="#booking">Book Appointment</a></li>
          <li><a href="#hours">Timings</a></li>
        </ul>
      </div>
      <div>
        <h4>Departments</h4>
        <ul>
          <li><a href="#">Cardiology</a></li>
          <li><a href="#">Dermatology</a></li>
          <li><a href="#">Pediatrics</a></li>
        </ul>
      </div>
      <div>
        <h4>Contact</h4>
        <ul>
          <li>+92 300 1234567</li>
          <li>info@alshifaclinic.pk</li>
          <li>Susan Road, Faisalabad</li>
        </ul>
      </div>
    </div>
    <div class="footer-bottom">
      <span>&copy; 2026 Alshifa Clinic. All rights reserved.</span>
      <span>Built for real patient records, not paper prescriptions.</span>
    </div>
  </div>
</footer>

<script>
  const menuToggle = document.getElementById('menuToggle');
  const siteNav = document.getElementById('siteNav');
  const navOverlay = document.getElementById('navOverlay');

  function closeMenu() {
    menuToggle.classList.remove('open');
    siteNav.classList.remove('open');
    navOverlay.classList.remove('open');
  }

  menuToggle.addEventListener('click', () => {
    menuToggle.classList.toggle('open');
    siteNav.classList.toggle('open');
    navOverlay.classList.toggle('open');
  });

  navOverlay.addEventListener('click', closeMenu);

  siteNav.querySelectorAll('a').forEach(link => {
    link.addEventListener('click', closeMenu);
  });
</script>

</body>
</html>