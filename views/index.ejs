        </div>
      </div>
      <div class="doctor-card">
        <div class="doctor-photo" style="background-image:url('https://images.unsplash.com/photo-1594824476967-48c8b964273f?auto=format&fit=crop&w=500&q=80');">
          <span class="doctor-tag">Dermatologist</span>
        </div>
        <div class="doctor-info">
